<!-- CDN 优选：cdn-config 提供线路与资源表，cdn-race 负责测速并通知 Service Worker。
     defer 保证按序执行，且不阻塞解析。详见 CDN-RACING.md -->
<script src="<%- url_for('/js/cdn-config.js') %>" defer></script>
<script src="<%- url_for('/js/cdn-race.js') %>" defer></script>

<link rel="preconnect" href="https://s4.zstatic.net" />
<link rel="preconnect" href="https://fonts.googleapis.cn" />
<link rel="preconnect" href="https://fonts.gstatic.cn" crossorigin />

<% if (theme.vue && theme.vue.enable) { const vueSri = cdn_sri('vue'); %>
<!-- Vue：地址取自主题 _config.yml 的 vue 段，integrity 由 cdn_sri() 从 cdn-config.js
     的 sri 读取。onerror 兜底用同字节的另一条线路，integrity 不需改动即可通过，
     只用于覆盖首访（SW 尚未接管）这一空窗。 -->
<script
  src="<%- theme.vue.src %>"
  <% if (vueSri) { %>integrity="<%- vueSri %>" crossorigin="anonymous"<% } %>
  <% if (theme.vue.fallback) { %>onerror="this.onerror=null;this.src='<%- theme.vue.fallback %>'"<% } %>
></script>
<% } %>
<% if (theme.fontAwesome && theme.fontAwesome.enable) { %>
<link rel="stylesheet" href="<%- theme.fontAwesome.src %>" />
<% } %>
<% if (theme.firaCode && theme.firaCode.enable) { %>
<link rel="stylesheet" href="<%- theme.firaCode.src %>" />
<% } %>

<% if (theme.jquery && theme.jquery.enable) { const jquerySri = cdn_sri('jquery'); %>
<!-- jQuery：地址取自主题 _config.yml 的 jquery 段，integrity 由 cdn_sri() 从
     cdn-config.js 的 sri 读取，哈希全站只有那一个出处。 -->
<script
  src="<%- theme.jquery.src %>"
  <% if (jquerySri) { %>integrity="<%- jquerySri %>" crossorigin="anonymous"<% } %>
  <% if (theme.jquery.fallback) { %>onerror="this.onerror=null;this.src='<%- theme.jquery.fallback %>'"<% } %>
></script>
<% } %>

<!-- PrismJS -->
<% if (theme.prismjs.enable) { %>
<!-- 基地址与版本取自主题 _config.yml 的 prismjs.cdn，需与 cdn-config.js 的 prismjs@<version> 一致 -->
<link
  rel="stylesheet"
  href="<%- theme.prismjs.cdn %>/themes/<%= theme.prismjs.theme %>.min.css"
/>
<% if (theme.prismjs.lineNumbers) { %>
<link
  rel="stylesheet"
  href="<%- theme.prismjs.cdn %>/plugins/line-numbers/prism-line-numbers.min.css"
/>
<% } %>
<!-- PrismJS 高亮脚本 -->
<script src="<%- url_for('/js/PrismJS.js') %>"></script>

<% } %>

<% if (theme.math.enable) { %>
<script src="https://s4.zstatic.net/ajax/libs/KaTeX/0.16.9/katex.min.js"></script>
<script src="https://s4.zstatic.net/ajax/libs/KaTeX/0.16.9/contrib/auto-render.min.js"></script>
<link
  rel="stylesheet"
  href="https://s4.zstatic.net/ajax/libs/KaTeX/0.16.9/katex.min.css"
/>
  <% } %> <% if (theme.crypto.enable && typeof page.secret !== "undefined") { %>
<script src="https://s4.zstatic.net/ajax/libs/crypto-js/4.2.0/crypto-js.min.js"></script>
<% } %> <% if (type === "archives" && theme.search.enable) { %>
<% } %> <% if (type === "post" && page.comments) { %> <% if
(theme.gitalk.enable) { %>
<script src="https://s4.zstatic.net/ajax/libs/gitalk/1.8.0/gitalk.min.js"></script>
<link
  rel="stylesheet"
  href="https://s4.zstatic.net/ajax/libs/gitalk/1.8.0/gitalk.min.css"
/>
<% } %> <% if (theme.waline.enable) { %>
<script src="https://s4.zstatic.net/ajax/libs/waline/2.15.8/waline.min.js"></script>
<link
  rel="stylesheet"
  href="https://s4.zstatic.net/ajax/libs/waline/2.15.8/waline.min.css"
/>
<link
  rel="stylesheet"
  href="https://s4.zstatic.net/ajax/libs/waline/2.15.8/waline-meta.min.css"
/>
<% } %> <% if (theme.twikoo.enable) { %>
<script
  src="https://s4.zstatic.net/npm/twikoo@1.6.44/dist/twikoo.min.js"
  integrity="sha384-dZ/hSVfTPHuzXyECOYCetAvMd0cgqWxN5Fh+mwo86PV4GdU9xgQ/MNzh/YM/lotR"
  crossorigin="anonymous"
></script>
<% } %> <% } %> <% if (type === "index") { %>
<% } %> <link rel="stylesheet" href="<%- url_for("/css/main.css") %>" /> <% if
(type==="photo") { %> <link rel="stylesheet" href="<%- url_for("/css/photo.css")
%>" /> <%}%>
